# Shop server settings (copy to .env next to docker-compose.yml)

# Which setup (see CLOUD-FIRST.md and SHOP-SERVER.md):
#   local   = this PC is the main POS, Railway is a read-only copy (Railway: POS_MODE=mirror)
#   standby = Railway is the main POS, this PC takes over when the internet drops (Railway: POS_MODE=cloud)
POS_MODE=local

# Password for the database on this PC (pick any long random text)
DB_PASSWORD=change-me-to-something-long

# The cloud copy on Railway, and the shared secret it expects.
# Leave both empty to run the shop server without a cloud copy.
CLOUD_URL=https://your-pos.up.railway.app
SYNC_TOKEN=paste-the-same-long-random-text-here-and-on-railway
